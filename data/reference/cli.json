  "commands": [
    {
      "id": "info",
      "name": "info",
      "synopsis": "netft info [HOST] [OPTIONS]",
      "description": "Show sensor identity and configuration.",
      "optionIds": [
        "verbose",
        "quiet",
        "color",
        "http-port",
        "rdt-port",
        "timeout",
        "format",
        "output"
      ],
      "positionals": [
        {
          "name": "HOST",
          "valueType": "host",
          "required": false,
          "values": []
        }
      ],
      "examples": [
        "netft info sensor.example",
        "netft info sensor.example --format json"
      ],
      "exitStatuses": [0, 2, 3, 6]
    },
    {
      "id": "monitor",
      "name": "monitor",
      "synopsis": "netft monitor [HOST] [OPTIONS]",
      "description": "Display the latest sensor sample at a bounded output rate.",
      "optionIds": [
        "verbose",
        "quiet",
        "color",
        "http-port",
        "rdt-port",
        "timeout",
        "format",
        "output",
        "rate",
        "duration"
      ],
      "positionals": [
        {
          "name": "HOST",
          "valueType": "host",
          "required": false,
          "values": []
        }
      ],
      "examples": [
        "netft monitor sensor.example",
        "netft monitor sensor.example --rate 50"
      ],
      "exitStatuses": [0, 2, 3, 4, 5, 6, 130]
    },
    {
      "id": "check",
      "name": "check",
      "synopsis": "netft check [HOST] [OPTIONS]",
      "description": "Run a bounded sensor stream health check.",
      "optionIds": [
        "verbose",
        "quiet",
        "color",
        "http-port",
        "rdt-port",
        "timeout",
        "format",
        "output",
        "duration",
        "min-rate",
        "max-loss",
        "max-reconnects"
      ],
      "positionals": [
        {
          "name": "HOST",
          "valueType": "host",
          "required": false,
          "values": []
        }
      ],
      "examples": [
        "netft check sensor.example",
        "netft check sensor.example --format json"
      ],
      "exitStatuses": [0, 2, 3, 4, 5, 6, 7, 130]
    },
    {
      "id": "record",
      "name": "record",
      "synopsis": "netft record [HOST] --output PATH [OPTIONS]",
      "description": "Record every accepted sensor sample to a bounded capture.",
      "optionIds": [
        "verbose",
        "quiet",
        "color",
        "http-port",
        "rdt-port",
        "timeout",
        "format",
        "output",
        "duration",
        "count"
      ],
      "positionals": [
        {
          "name": "HOST",
          "valueType": "host",
          "required": false,
          "values": []
        }
      ],
      "examples": [
        "netft record sensor.example --output measurement.csv",
        "netft record sensor.example --output measurement.ndjson --duration 60s"
      ],
      "exitStatuses": [0, 2, 3, 4, 5, 6, 8, 130]
    },
    {
      "id": "bias",
      "name": "bias",
      "synopsis": "netft bias [HOST] [OPTIONS]",
      "description": "Apply a software bias after explicit confirmation.",
      "optionIds": [
        "verbose",
        "quiet",
        "color",
        "http-port",
        "rdt-port",
        "timeout",
        "format",
        "output",
        "yes"
      ],
      "positionals": [
        {
          "name": "HOST",
          "valueType": "host",
          "required": false,
          "values": []
        }
      ],
      "examples": [
        "netft bias sensor.example",
        "netft bias sensor.example --yes"
      ],
      "exitStatuses": [0, 2, 3, 4, 5, 6, 130]
    },
    {
      "id": "completion",
      "name": "completion",
      "synopsis": "netft completion SHELL",
      "description": "Generate a shell completion script.",
      "optionIds": ["verbose", "quiet", "color"],
      "positionals": [
        {
          "name": "SHELL",
          "valueType": "choice",
          "required": true,
          "values": ["bash", "zsh", "fish", "powershell"]
        }
      ],
      "examples": ["netft completion bash", "netft completion powershell"],
      "exitStatuses": [0, 2]
    }
  ],
  "exitStatuses": [
    {
      "code": 0,
      "meaning": "Completed successfully"
    },
    {
      "code": 2,
      "meaning": "Invalid command line or configuration"
    },
    {
      "code": 3,
      "meaning": "Sensor discovery failed"
    },
    {
      "code": 4,
      "meaning": "Stream connection or acquisition failed"
    },
    {
      "code": 5,
      "meaning": "Sensor reported a fault"
    },
    {
      "code": 6,
      "meaning": "Input/output operation failed"
    },
    {
      "code": 7,
      "meaning": "A check acceptance criterion failed"
    },
    {
      "code": 8,
      "meaning": "Recording integrity could not be guaranteed"
    },
    {
      "code": 130,
      "meaning": "Interrupted"
    }
  ],

    },
    {
      "id": "output",
      "longName": "output",
      "valueType": "path",
      "description": "Write output to a file.",
      "repeatable": false,
      "values": []
    },
    {
      "id": "http-port",
      "longName": "http-port",
      "valueType": "port",
      "description": "Set the sensor HTTP port.",
      "repeatable": false,
      "values": []
    },
    {
      "id": "rdt-port",
      "longName": "rdt-port",
